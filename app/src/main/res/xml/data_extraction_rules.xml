<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <!-- Se excluye la base de datos (transacciones, presupuestos, hash de password de UserEntity)
         para que ni el backup en la nube ni la transferencia entre dispositivos puedan extraer
         datos financieros/de cuenta del usuario fuera del propio dispositivo. -->
    <cloud-backup>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="."/>
        <exclude domain="sharedpref" path="."/>
    </device-transfer>
</data-extraction-rules>