<?xml version="1.0" encoding="utf-8"?>
<!-- La app es 100% local (sin backend propio): el unico trafico de red que genera es el de
     AdMob, Google Play Billing y Google Sign-In, todo por HTTPS. Sin excepciones de cleartext. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>